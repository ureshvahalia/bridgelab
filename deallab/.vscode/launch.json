{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug deallab",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/msys2/Debug/deallab.exe",
            "args": ["-d", "statwork", "8", "Any", "Any"],
            // "args": ["-d", "statwork", "-p", "2N3Nc", "-S", "-F", "2Nina.csv", "-E", "2048", "2048"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder};${workspaceFolder}/bin/Debug;C:/msys64/ucrt64/bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "logging": {
                "moduleLoad": false
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable thread messages",
                    "text": "set print thread-events off",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable shared library messages",
                    "text": "set print symbol-loading off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
            "miDebuggerArgs": "-q -silent",
            "targetArchitecture": "x86_64",
        }
    ]
}
